{
  "name": "collectiblemarkets",
  "private": true,
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter '*' --parallel dev",
    "build": "bun run --cwd apps/web build",
    "check": "tsc --noEmit && bun run --cwd apps/web check",
    "test": "bun test packages apps/worker",
    "format": "prettier --write apps packages scripts docs *.md *.json .github/workflows/ci.yml",
    "format:check": "prettier --check apps packages scripts docs *.md *.json .github/workflows/ci.yml",
    "db:generate": "bun run --cwd packages/db generate",
    "db:migrate": "bun run packages/db/src/migrate.ts",
    "start:web": "bun run --cwd apps/web start",
    "start:worker": "bun run apps/worker/src/index.ts"
  },
  "devDependencies": {
    "@solana/kit": "^8.6.0",
    "@types/bun": "latest",
    "@types/node": "24",
    "prettier": "^3.10.1",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  }
}
