DEMO_MODE=simulated
SOLANA_NETWORK=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com
DATABASE_URL=
WORKER_URL=http://localhost:4001
APP_URL=http://localhost:3000
GEMINI_ENVIRONMENT=production
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_ID=
PRIVY_APP_SECRET=
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
GEMINI_OAUTH_PRODUCTION_APPROVED=false
TOKEN_ENCRYPTION_KEY=
CARD_HEDGE_API_KEY=
PHYGITALS_API_KEY=
QUICKNODE_RPC_URL=
QUICKNODE_DAS_RPC_URL=
QUICKNODE_WEBHOOK_SECRET=
# Shared, persistent allowance for this verified billing period. Missing/expired
# settings stop metered RPC calls. No automatic reset. Cutoff <= 75% of included.
QUICKNODE_BUDGET_ID=
QUICKNODE_BUDGET_START=
QUICKNODE_BUDGET_END=
QUICKNODE_INCLUDED_CREDITS=80000000
QUICKNODE_CREDIT_CUTOFF=60000000
QUICKNODE_BASELINE_CREDITS=1000000
# Optional native Circle USDC override; must match SOLANA_NETWORK.
# Devnet defaults to 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU; CC test USDC is separate.
SOLANA_USDC_MINT=
# Server-only Relay Dashboard App key. Mainnet quote/v2 requires it.
# Quotes do not authorize execution; testnet anonymous quotes were verified separately.
RELAY_API_KEY=
COLLECTOR_CRYPT_NETWORK=mainnet
ENABLE_LIVE_TRADING=false
ENABLE_GEMINI_CRYPTO_SEND=false
ENABLE_RELAY=false
ENABLE_CC_PURCHASES=false
# Explicit wallet-bound devnet test release only. Mainnet remains disabled.
ENABLE_CC_DEVNET_TESTS=false
CC_DEVNET_TEST_WALLET=
ENABLE_PHY_PACK_BUYS=false
ENABLE_PUBLIC_FMV=false
ENABLE_PARTNER_REDEMPTION=false
# No money-moving operation is released by a flag alone. See release gates.

# Grail EVM purchases: server-only provider/RPC credentials, never NEXT_PUBLIC.
BASE_RPC_URL=https://mainnet.base.org
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ENABLE_GRAIL_TRADING=false
GRAIL_TRADING_VERIFIED=false
# Optional controlled live test before general release, only this wallet + chain.
# Still requires DEMO_MODE=live and ENABLE_GRAIL_TRADING=true. Keep blank until approved.
GRAIL_TEST_WALLET=
GRAIL_TEST_CHAIN_ID=
GRAIL_MAX_TRADE_AMOUNT=25
# Gas sponsorship is OFF. Each approval and swap requires user-paid ETH.
GRAIL_MAX_PEG_TRADE_AMOUNT=0.01
# Initial exact Permit2 approval is a separate user-paid ETH transaction.

# Pull & Predict uses the persistent demo ledger; never mainnet funds.
# demo-csprng is explicitly labeled practice randomness. Enable MagicBlock only
# after deploying and verifying programs/pull-randomness on Solana devnet.
PULL_RANDOMNESS=demo-csprng
PULL_MAGICBLOCK_PROGRAM_ID=
PULL_MAGICBLOCK_DEVNET_RPC_URL=https://api.devnet.solana.com
